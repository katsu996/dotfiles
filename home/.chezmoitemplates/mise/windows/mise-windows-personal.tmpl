{{/* Windows Personal用の設定 */}}
[settings]
minimum_release_age = "1d"
minimum_release_age_excludes = [
  "npm:@katsu996/common-utils",
  "npm:@katsu996/md2html"
]
idiomatic_version_file_enable_tools = ["python"]
experimental = true
python.uv_venv_auto = "create|source"

[settings.pipx]
uvx = true

[tools]
"aqua:cli/cli" = "latest"
bun = "latest"
deno = "latest"
go = "latest"
java = "24"
node = "24"
npm = "12"
"npm:@elgato/cli" = "latest"
"npm:@fission-ai/openspec" = "latest"
"npm:@katsu996/common-utils" = { version = "latest", npm_args = "--allow-scripts=@katsu996/common-utils" }
"npm:@katsu996/md2html" = { version = "latest", npm_args = "--allow-scripts=@katsu996/md2html" }
"npm:atcoder-cli" = "latest"
"npm:cc-sdd" = "latest"
"npm:hunkdiff" = "latest"
"pipx:graphifyy" = "latest"
opencode = "latest"
"pipx:online-judge-tools/oj" = "latest"
pnpm = "11"
python = "3.13"
rust = "latest"
uv = "latest"
# yarn = "4"
zig = "latest"

[tasks.cc]
description = "Claude Code Bypass all permission checks"
run = "claude --dangerously-skip-permissions"

[tasks.dot]
description = "chezmoiを最新化"
run = "chezmoi update --apply"

[tasks.dotfiles]
description = "chezmoiを最新化"
run = "chezmoi update --apply"

[tasks.killPort]
description = "指定ポートのプロセスを終了"
usage = 'arg "<port>" help="終了するポート番号"'
run = "Get-NetTCPConnection -LocalPort $env:usage_port -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }"
shell = "powershell -NoProfile -Command"

[tasks.o]
description = "更新可能なパッケージを出力"
run = [
    "mise outdated",
    "winget upgrade"
]

[tasks.up-all]
description = "mise, WinGetのパッケージを更新"
run = [
    "mise upgrade",
    "winget upgrade --all"
]

[tasks.up-winget]
description = "WinGetのパッケージを更新"
run = "winget upgrade --all"
