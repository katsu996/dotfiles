{{/* Windows Personal用の設定 */}}
[settings]
minimum_release_age = "1d"
minimum_release_age_excludes = [
  "npm:@katsu996/common-utils",
  "npm:@katsu996/md2html"
]
idiomatic_version_file_enable_tools = ["python"]
experimental = true
python.uv_venv_auto = "create|source"

[settings.pipx]
uvx = true

[tools]
"aqua:cli/cli" = "latest"
bun = "latest"
deno = "latest"
"github:can1357/oh-my-pi" = "latest"
go = "latest"
java = "24"
node = "24"
npm = "12"
"npm:@earendil-works/pi-coding-agent" = { version = "latest", npm_args = "--ignore-scripts" }
"npm:@elgato/cli" = "latest"
"npm:@fission-ai/openspec" = "latest"
"npm:@katsu996/common-utils" = { version = "latest", npm_args = "--allow-scripts=@katsu996/common-utils" }
"npm:@katsu996/md2html" = { version = "latest", npm_args = "--allow-scripts=@katsu996/md2html" }
"npm:atcoder-cli" = "latest"
"npm:cc-sdd" = "latest"
"npm:hunkdiff" = "latest"
"pipx:graphifyy" = "latest"
opencode = "latest"
"pipx:online-judge-tools/oj" = "latest"
pnpm = "11"
python = "3.13"
rust = "latest"
uv = "latest"
# yarn = "4"
zig = "latest"

[tasks.cc]
description = "Claude Code Bypass all permission checks"
run = "claude --dangerously-skip-permissions"

[tasks.df]
description = "chezmoiを最新化"
run = "chezmoi update"

[tasks.killPort]
description = "指定ポートのプロセスを終了"
usage = 'arg "<port>" help="終了するポート番号"'
run = "Get-NetTCPConnection -LocalPort $env:usage_port -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }"
shell = "powershell -NoProfile -Command"

[tasks.o]
description = "更新可能なパッケージを出力"
run = [
    "mise outdated",
    "winget upgrade"
]

[tasks.up-all]
description = "mise, WinGetのパッケージを更新"
run = [
    "mise upgrade",
    "winget upgrade --all"
]

[tasks.up-winget]
description = "WinGetのパッケージを更新"
run = "winget upgrade --all"

[tasks.in-winget]
description = "WinGetの未導入パッケージをインストール"
shell = "powershell -NoProfile -Command"
run = """
$packages = @(
{{- range .packages.windows.wingets.common }}
    '{{ . }}'
{{- end }}
{{- range .packages.windows.wingets.personal }}
    '{{ . }}'
{{- end }}
)
$i = 0
foreach ($package in $packages) {
    $i++
    winget list -e --id "$package" --source winget --disable-interactivity --accept-source-agreements | Out-Null
    if ($LASTEXITCODE -eq 0) {
        Write-Host "[$i/$($packages.Count)] $package : already installed, skipping."
        continue
    }
    Write-Host "[$i/$($packages.Count)] Installing $package with WinGet..."
    winget install -e --id "$package" --source winget --disable-interactivity --silent --accept-source-agreements --accept-package-agreements
}
"""
