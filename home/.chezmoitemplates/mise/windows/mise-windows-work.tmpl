{{/* Windows Work用の設定 */}}
[settings]
minimum_release_age = "1d"
idiomatic_version_file_enable_tools = ["python"]
experimental = true
python.uv_venv_auto = "create|source"

[settings.pipx]
uvx = true

[tools]
"aqua:aws/aws-cli" = "latest"
"aqua:cli/cli" = "latest"
"aqua:jdx/usage" = "latest"
bun = "latest"
deno = "latest"
go = "latest"
java = "24"
node = "22"
npm = "12"
"npm:hunkdiff" = "latest"
"pipx:graphifyy" = "latest"
pnpm = "11"
python = "3.13"
rust = "latest"
uv = "latest"
# yarn = "4"
zig = "latest"

[tasks.cc]
description = "Claude Code Bypass all permission checks"
run = "claude --dangerously-skip-permissions"

[tasks.dot]
description = "chezmoiを最新化"
run = "chezmoi update --apply"

[tasks.killPort]
description = "指定ポートのプロセスを終了"
usage = 'arg "<port>" help="終了するポート番号"'
run = "Get-NetTCPConnection -LocalPort $env:usage_port -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }"
shell = "powershell -NoProfile -Command"

[tasks.o]
description = "更新可能なパッケージを出力"
run = [
    "mise outdated",
    "winget upgrade"
]

[tasks.up-all]
description = "mise, WinGetのパッケージを更新"
run = [
    "mise upgrade",
    "winget upgrade --all"
]

[tasks.up-winget]
description = "WinGetのパッケージを更新"
run = "winget upgrade --all"

[tasks.in-winget]
description = "WinGetの未導入パッケージをインストール"
shell = "powershell -NoProfile -Command"
run = """
$packages = @(
{{- range .packages.windows.wingets.common }}
    '{{ . }}'
{{- end }}
{{- range .packages.windows.wingets.work }}
    '{{ . }}'
{{- end }}
)
foreach ($package in $packages) {
    winget list -e --id "$package" --accept-source-agreements | Out-Null
    if ($LASTEXITCODE -eq 0) { continue }
    Write-Host "Installing $package with WinGet..."
    winget install -e --id "$package" --source winget --silent --accept-source-agreements --accept-package-agreements
}
"""
