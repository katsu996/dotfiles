# -*-mode:conf-toml-*- vim:ft=toml

# ~/.local/share/chezmoi/home/.chezmoi.toml.tmpl
# =============================================================================
# Used to customize configuration when doing a `chezmoi init`.
#
# This template file will trigger prompts to fill-in machine-specific
# templateable values. The resulting file is then created at
# `~/.config/chezmoi/chezmoi.toml`
# See https://www.chezmoi.io/docs/how-to/
#
# {{- /* This file supports Go's text/template language. */}}

# Values can be supplied non-interactively via `chezmoi init --promptString`,
# e.g. --promptString email=mail@example.com,name=firstname.lastname,role=work
# Keys must match the prompt texts below and must not contain commas.

# {{- $email := promptString "email" }}
# {{- $name := promptString "name" }}
# {{- $role := promptString "role" "personal" }}

[data]
    email = "{{ $email }}"
    name = "{{ $name }}"
    role = "{{ $role }}"
